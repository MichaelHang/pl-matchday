classDiagram
    direction LR

    %% ── Core · domain models ──

    class Match {
        +Int id
        +Int~opt~ matchday
        +String~opt~ utcDate
        +String~opt~ status
        +Team homeTeam
        +Team awayTeam
        +Score~opt~ score
    }

    class Team {
        +Int id
        +String name
        +String~opt~ shortName
        +String~opt~ crest
        +nameZh
        +displayName(chinese) String
    }

    class StandingRow {
        +Int position
        +Team team
        +Int playedGames
        +Int won
        +Int draw
        +Int lost
        +Int points
        +Int goalsFor
        +Int goalsAgainst
        +Int goalDifference
        +String~opt~ form
        +String~opt~ status
        +VenueStats~opt~ home
        +VenueStats~opt~ away
    }

    class PlayerLite {
        +Int~opt~ id
        +String name
        +nameZh
        +displayName(chinese) String
    }

    class Scorer {
        +PlayerLite player
        +Team team
        +Int goals
        +Int~opt~ assists
    }

    class Injury {
        +PlayerLite player
        +Team team
        +String status
        +String~opt~ news
        +Int~opt~ chanceOfPlayingNextRound
    }

    %% ── Core · data layer ──

    class DataRepository {
        <<enumeration>>
        +matches() tuple
        +standings() tuple
        +scorers() tuple
        +assists() tuple
        +injuries() tuple
        +gameweeks() array
        +currentGameweek() Int~opt~
        +invalidateFixtures()
        +clearCache()
        +shouldFallback(err) Bool
    }

    class MemoryStore {
        <<actor>>
        +cachedFixtures() array~opt~
        +cachedBootstrap() FPLBootstrap~opt~
        +rememberFixtures(array)
        +lastGoodFixturesSnapshot() array~opt~
        +rememberBootstrap(FPLBootstrap)
        +lastGoodBootstrapSnapshot() FPLBootstrap~opt~
        +rememberStandings(ESPNStandingsCoreResponse)
        +lastGoodStandingsSnapshot() ESPNStandingsCoreResponse~opt~
        +clear()
        +clearFixtures()
    }

    class CacheStore {
        <<actor>>
        +get(key, ttl) T~opt~
        +getStale(key) T~opt~
        +set(key, value)
        +remove(key)
        +clear()
    }

    class FPLProvider {
        +fetchBootstrap() FPLBootstrap
        +fetchFixtures() array
    }

    class ESPNProvider {
        +fetchStandings(season) ESPNStandingsCoreResponse
        +fetchScoreboardSchedule(dates) ESPNScoreboardResponse
    }

    class FPLTranslator {
        <<enumeration>>
        +matches(fixtures, teams) array
        +teams(bootstrap) array
        +scorers(bootstrap, limit) array
        +assists(bootstrap, limit) array
        +injuries(bootstrap) array
        +isTransferDeparture(news) Bool
    }

    class ESPNTranslator {
        <<enumeration>>
        +standingRows(resp) array
        +matches(resp) array
        +stableID(string) Int
    }

    class StandingsAggregator {
        <<enumeration>>
        +aggregate(matches) array
    }

    class StandingsEnricher {
        <<enumeration>>
        +enrich(rows, matches) array
        +venueStats(teamId, matches, isHome) VenueStats~opt~
        +formString(teamId, matches, last) String~opt~
    }

    %% ── App ──

    class AppState {
        <<observable>>
        +selected AppSection
        +language AppLanguage
        +timeZone DisplayTimeZone
        +source DataSource
        +refreshNonce Int
        +autoRefreshDuringMatches Bool
        +lastKnownMatches array
        +refresh(scoresOnly)
        +reportLiveSchedule(matches)
        +configureAutoRefresh()
    }

    class AutoRefreshScheduler {
        <<enumeration>>
        +schedule(matches, now) RefreshSchedule
        +refreshInterval(...) TimeInterval~opt~
    }

    %% ── Features · view models ──

    class TodayViewModel {
        <<observable>>
        +matches array
        +currentRound Int
        +positions Map
        +load()
        +featured(tz) Match~opt~
        +columns(tz) TodayColumns
    }

    class FixturesViewModel {
        <<observable>>
        +matches array
        +focusedRound Int
        +mode FixturesMode
        +availableRounds array
        +seasonProgress SeasonProgress~opt~
        +load()
        +roundSnapshots(progress) array
        +initialFocusRound(...) Int
    }

    class StandingsViewModel {
        <<observable>>
        +rows array
        +tab StandingsTab
        +load()
        +ranked(tab) array
    }

    %% ── Localization ──

    class PlayerNameMap {
        <<enumeration>>
        +zh(for player) String~opt~
        +builtInName(forId) String~opt~
        +missing(ids) array
    }

    class PlayerNameStore {
        <<observable>>
        +overrides PlayerNameOverrides
        +current PlayerNameOverrides
        +commit(overrides)
    }

    class TranslationStore {
        <<enumeration>>
        +load(baseName, locale) T~opt~
    }

    class TeamNameMap {
        <<enumeration>>
        +zh(for team) String~opt~
    }

    %% ── Relations ──

    DataRepository ..> FPLProvider : network
    DataRepository ..> ESPNProvider : fallback
    DataRepository --> MemoryStore : session + last-known-good
    DataRepository --> CacheStore : disk (TTL)
    DataRepository ..> FPLTranslator : derive
    DataRepository ..> ESPNTranslator : translate
    DataRepository ..> StandingsAggregator : standings tier 2

    TodayViewModel ..> DataRepository
    TodayViewModel ..> TodayFilter
    TodayViewModel ..> TodayFeatured
    FixturesViewModel ..> DataRepository
    FixturesViewModel ..> CurrentRoundInference
    StandingsViewModel ..> DataRepository
    StandingsViewModel ..> StandingsAggregator
    StandingsViewModel ..> StandingsEnricher

    AppState ..> AutoRefreshScheduler
    AppState --> PlayerNameStore : eager load

    PlayerNameMap ..> TranslationStore : JSON resource
    PlayerNameMap --> PlayerNameStore : overrides
    TeamNameMap ..> TranslationStore : JSON resource

    Match o-- Team
    Match o-- Score
    StandingRow o-- Team
    StandingRow o-- VenueStats
    Scorer o-- PlayerLite
    Scorer o-- Team
    Injury o-- PlayerLite
    Injury o-- Team
